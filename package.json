		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.6",
		"@astrojs/vercel": "11.0.22",
		"@vercel/analytics": "2.0.1",
		"astro": "7.4.13",
		"astro-expressive-code": "0.44.4",
		"astro-icon": "1.2.0",
		"clsx": "2.1.1",
		"mdast-util-to-string": "4.0.0",
		"reading-time": "1.5.0",
		"rehype-external-links": "3.0.0",
		"rehype-unwrap-images": "1.0.0",
		"sharp": "0.35.5",
