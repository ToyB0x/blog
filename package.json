{
	"name": "blog",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"dev": "astro check --watch & astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "biome check",
		"check:write": "biome check --write",
		"check:write:unsafe": "biome check --write --unsafe",
		"typecheck": "tsc --noEmit",
		"test:e2e": "start-server-and-test 'pnpm start' localhost:4321 'playwright test'"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/mdx": "8.0.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/vercel": "11.0.10",
		"@vercel/analytics": "2.0.1",
		"astro": "7.3.3",
		"astro-expressive-code": "0.44.2",
		"astro-icon": "1.2.0",
		"clsx": "2.1.1",
		"mdast-util-to-string": "4.0.0",
		"reading-time": "1.5.0",
		"rehype-external-links": "3.0.0",
		"remark-unwrap-images": "4.0.1",
		"sharp": "0.35.4",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "1.63.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.6",
		"start-server-and-test": "3.0.12",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": "24.21.0"
	},
	"packageManager": "pnpm@12.5.1",
	"volta": {
		"node": "24.21.0",
		"pnpm": "12.5.1"
	}
